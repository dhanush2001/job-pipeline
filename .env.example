# Copy to .env and fill in. These are read by the pipeline at runtime.
# .env is gitignored -- real keys never get committed.

# Required: DeepSeek API key (platform.deepseek.com)
DEEPSEEK_API_KEY=

# Optional: Anthropic API key (console.anthropic.com) -- only needed when a
# claude-* model is configured or passed with --model
ANTHROPIC_API_KEY=

# Optional: Adzuna general-board aggregator (developer.adzuna.com, free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: contact email sent in the HTTP User-Agent when scanning boards
PIPELINE_CONTACT=

# Optional: GitHub token to raise the repo-fetch rate limit / read private repos
GITHUB_TOKEN=
